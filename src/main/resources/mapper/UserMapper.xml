<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acmp.compute.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.acmp.compute.entity.User">
        <id     column="id"              property="id"/>
        <result column="username"        property="username"/>
        <result column="password_hash"   property="passwordHash"/>
        <result column="display_name"    property="displayName"/>
        <result column="email"           property="email"/>
        <result column="role"            property="role"/>
        <result column="organization_id" property="organizationId"/>
        <result column="status"          property="status"/>
        <result column="created_at"      property="createdAt"/>
        <result column="updated_at"      property="updatedAt"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM app_user WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT * FROM app_user WHERE username = #{username}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM app_user ORDER BY created_at DESC
    </select>

    <insert id="insert">
        INSERT INTO app_user (id, username, password_hash, display_name, email, role, organization_id, status, created_at, updated_at)
        VALUES (#{id}, #{username}, #{passwordHash}, #{displayName}, #{email}, #{role}, #{organizationId}, #{status},
                CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
    </insert>

    <update id="update">
        UPDATE app_user
        SET display_name = #{displayName},
            email        = #{email},
            role         = #{role},
            status       = #{status},
            updated_at   = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
</mapper>
