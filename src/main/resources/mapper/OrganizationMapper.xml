<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acmp.compute.mapper.OrganizationMapper">
    <resultMap id="BaseResultMap" type="com.acmp.compute.entity.Organization">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <select id="findById" resultMap="BaseResultMap">SELECT * FROM organization WHERE id = #{id}</select>
    <select id="findAll" resultMap="BaseResultMap">SELECT * FROM organization ORDER BY created_at DESC</select>
    <insert id="insert">
        INSERT INTO organization (id, code, name, created_at, updated_at)
        VALUES (#{id}, #{code}, #{name}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
    </insert>
    <update id="update">
        UPDATE organization SET code = #{code}, name = #{name}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>
</mapper>
