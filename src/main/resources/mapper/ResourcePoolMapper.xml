<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acmp.compute.mapper.ResourcePoolMapper">

    <resultMap id="BaseResultMap" type="com.acmp.compute.entity.ResourcePool">
        <id column="id" property="id"/>
        <result column="pool_type" property="poolType"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM resource_pool WHERE id = #{id}
    </select>

    <insert id="upsert">
        MERGE INTO resource_pool
            (id, pool_type, name, description, status, updated_at)
        KEY(id) VALUES
            (#{id}, #{poolType}, #{name}, #{description}, #{status}, CURRENT_TIMESTAMP)
    </insert>
</mapper>
